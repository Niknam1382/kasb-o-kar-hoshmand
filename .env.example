# --- دیتابیس ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kasbokar
# د(ج): docker-compose این سه را برایِ سرویسِ db از همین‌جا می‌خواند (پیش‌فرض: postgres/postgres/kasbokar).
# روی سرورِ واقعی رمزِ قوی بگذار و *همزمان* نامِ کاربری/رمزِ DATABASE_URL را هم همان کن، وگرنه ربات وصل نمی‌شود.
# نکته: رمزِ volumeِ ساخته‌شده‌یِ قدیمی عوض نمی‌شود؛ برایِ تغییرِ رمز روی دیتابیسِ موجود از ALTER ROLE استفاده کن.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kasbokar

# --- ربات اصلی تلگرام (از @BotFather بگیر) ---
MAIN_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- آیدی‌های تلگرامِ ادمین‌های پلتفرم (با کاما جدا کن، بدون فاصله) ---
ADMIN_TELEGRAM_IDS=123456789,987654321

# --- کلید رمزنگاری برای ذخیره‌ی امنِ توکنِ ربات‌های فروشگاهی در دیتابیس ---
# از P18 این کلید به توکنِ درگاهِ بله، کلیدِ AI (استخر و تنهایی)، کلیدِ پیامکِ کاوه‌نگار
# و شماره کارتِ پلتفرم هم بخورد می‌شه ⇒ بدونِ آن همه در حالتِ «متنِ ساده» یا «فقط fallback» می‌مانند.
# با این دستور یه کلید تازه بساز: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- حالت اجرا: polling (برای تست ساده‌تره، نیازی به دامنه/HTTPS نداره) یا
# webhook (برای پروداکشن، سریع‌تره ولی نیاز به یه آدرسِ HTTPS معتبر داره) ---
RUN_MODE=polling

# --- فقط در حالت webhook لازمه: آدرسِ عمومیِ HTTPS ای که این سرویس روش بالاست ---
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_LISTEN_HOST=0.0.0.0
WEBHOOK_LISTEN_PORT=8000
# د(الف): در RUN_MODE=webhook این مقدار *الزامی* است و اگر خالی باشد برنامه اصلاً بالا نمی‌آید —
# وگرنه هر کسی می‌تواند به /webhook/main آپدیتِ جعلی (حتی با هویتِ ادمین) بفرستد.
# یک رشته‌ی تصادفیِ بلند بگذار. در RUN_MODE=polling لازم نیست.
MAIN_BOT_WEBHOOK_SECRET=
# اختیاری — فقط اگه می‌خواید Bale Pay رو فعال کنید لازمه. جزئیات:
# docs/changelog-phase1a-recovery.md (این یکپارچه‌سازی مستقل تاییدنشده‌ست).
# P18 · A1: هر دو مقدارِ زیر را می‌شود از پنلِ ادمین هم گذاشت
# («🔑 تنظیمات کلیدها › 🔵 توکنِ رباتِ بله / 🔵 توکنِ درگاهِ بله‌پی»)، بدونِ ری‌استارت و رمزنگاری‌شده.
# اولویت با مقدارِ پنل است؛ .env فقط پشتیبان/پیش‌فرض است.
BALE_BOT_TOKEN=
# رازِ وب‌هوکِ بله: در BALE_UPDATES_MODE=polling (پیش‌فرض) اصلاً لازم نیست.
# در حالتِ webhook هم لازم نیست دستی بگذاری — برنامه خودش یک رازِ تصادفی می‌سازد،
# رمزنگاری‌شده ذخیره می‌کند و در «🧪 آزمایشِ بله‌پی» نشانت می‌دهد.
# P40: تا وقتی BALE_UPDATES_MODE=polling است، endpoint /webhook/bale اصلاً سرویس نمی‌شود
# (۴۰۴) — چون رازی وجود ندارد و باز بودنش یعنی هر کسی رویِ شبکه می‌تواند آپدیتِ جعلی بفرستد.
BALE_WEBHOOK_SECRET=
# polling (پیش‌فرض؛ نیازی به HTTPSِ عمومی نیست) یا webhook
BALE_UPDATES_MODE=polling
# سطحِ لاگ: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# آدرسِ پایه‌یِ APIِ بله (مستندات: https://tapi.bale.ai)؛ فقط اگه بله دامنه رو عوض کرد دست بزن
BALE_API_BASE=https://tapi.bale.ai

# --- حالت احراز هویتِ ثبت‌نام: test (بدون نیاز به پیامک/ایمیل واقعی، کدِ تایید
# مستقیم توی چت نمایش داده می‌شه — برای تستِ محلی) / sms (با کاوه‌نگار، کلیدش از
# پنل ادمین تنظیم می‌شه، نه از اینجا) / email (با SMTP، تنظیماتش پایین‌تره) ---
AUTH_MODE=test

# --- فقط در حالت AUTH_MODE=email لازمه ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- ظرفیت (اختیاری؛ پیش‌فرض‌ها برایِ شروع کافیه) ---
# اندازه‌یِ استخرِ اتصال‌هایِ دیتابیس. سرِ‌جمعِ workers × DB_POOL_SIZE باید از max_connections
# پستگرس (پیش‌فرض ۱۰۰) کمتر بمونه.
# چرا overflow صفر: بارسنجیِ P20-F رویِ همین کد — در همزمانیِ ۵۰ با overflow=30 فقط
# ۴۸ پیام/ثانیه و میانگینِ ۹۴۶ms؛ با همان استخر و overflow=0 → ۱۳۶ پیام/ثانیه و ۲۴۵ms.
# ساختنِ اتصالِ اضافه در هر موج گران‌تر از صفِ کوتاه است.
# DB_POOL_SIZE=25
# DB_MAX_OVERFLOW=0
# DB_POOL_TIMEOUT=15
# P47: این عدد «سقفِ کلِ پلتفرم» است، نه سقفِ هرِ کلید. سقفِ خودِ هرِ کلید در پنلِ ادمین
# (منویِ «🔑 استخرِ کلیدهایِ AI» → «🔢 سقفِ همزمانیِ همینِ کلید») نوشته می‌شود؛ کلیدهایی که
# عددی ننوشته‌اند این مقدار را مساوی بینِ خودشان تقسیم می‌کنند.
# مثالِ ظرفیت: ۱۰ کلید × سقفِ ۲۰۰ ⇒ برایِ ۲٬۰۰۰ درخواستِ هم‌زمان این را ۲۰۰۰ بگذار.
# AI_MAX_CONCURRENT_CALLS=40
# P47: سقفِ صبرِ یکِ درخواست *در صفِ* AI (بعد ازِ این‌که همه‌یِ کلیدها پر بودند) به ثانیه.
# این زمانِ پاسخ نیست؛ زمانِ صف است. بعد ازِ آن به مشتری گفته می‌شود بعداً تلاش کند.
# AI_QUEUE_TIMEOUT_SECONDS=120
# P47: سقفِ سوکت‌هایِ هم‌زمان aiohttp به هرِ میزبانِ سرویسِ AI. پیش‌فرضِ خودِ aiohttp ۱۰۰ بود
# و همان گلوگاهِ خاموشِ مسیرِ AI (۰ = بی‌سقف؛ governorِ واقعی AI_MAX_CONCURRENT_CALLS است).
# AI_HTTP_POOL_LIMIT=0
# P42 · موردِ ۳۲: سقفِ صبرِ یکِ فراخوانیِ AI به ثانیه. پاسخ‌هایِ بلندِ مودِ مشاوره‌ای با
# ۶۰ ثانیه‌یِ ثابتِ قدیمی تنگضا می‌شدند و مشتری بی‌پاسخ می‌ماند. اگر ارائه‌دهنده‌ات کند است
# بالا ببر (مثلاً ۱۲۰)؛ توجه کن که تایم‌اوت *تکرار نمی‌شود*، پس این عدد سقفِ صبرِ مشتری است.
# AI_TIMEOUT_SECONDS=90
# P29: چند فروشگاه هم‌زمان در راه‌اندازی ثبت/پولینگ شروع کنند. با ۵۰۰ فروشگاه، بی‌این عدد همهٔ
# delete_webhook در یکِ لحظه می‌روند (حالتِ polling) یا ۵۰۰×RTT منتظر می‌مانی (حالتِ webhook).
# کم کردنش برایِ سرورِ کوچک یا IP حساس؛ زیاد کردنش فقط سرعتِ بوت. هیچ رباتی جا نمی‌افتد.
# BOT_REGISTER_CONCURRENCY=24
# P29: سقفِ رمِ سرویسِ ربات در داکر. عددِ اندازه‌گیری‌شده: هر اتصالِ ربات ≈ ۴۱۳ کیلوبایت
# ⇒ ۵۰۰ فروشگاه ≈ ۲۰۲ مگابایت رویِ ~۲۱۷ مگابایتِ پایه + سوکت‌هایِ long-poll. برایِ بیش از
# ~۳۰۰ فروشگاه این را رویِ 2g بگذار (و سرور را هم طبقِ لایهٔ مربوط در playbook بگیر).
# BOT_MEM_LIMIT=1g
# P29: مهلتِ «هنوز بوت می‌شود» برایِ healthcheck. تا پایانِ بارگذاریِ ربات‌ها /health عمداً 503
# می‌دهد؛ با ناوگانِ بزرگ (پاسِ بیوگرافیِ اولین بوت ترتیبی است) این را بالا ببر.
# BOT_HEALTH_START_PERIOD=40s

# P21-B (O2): در حالتِ polling هم یک اپِ سلامتِ کوچک بالا بیاید (فقط /health و /metrics؛
# هیچ مسیرِ webhook در آن نیست). false ⇒ کلاً سروری بالا نمی‌آید.
# HEALTH_ENABLED=true

# P32: نگهدارندهٔ حالتِ مکالمه (FSM). memory = رفتارِ همیشگی (با ری‌استارت می‌پرد)؛
# postgres = حالتِ چک‌اوت رویِ دیتابیس می‌ماند و از ری‌استارت رد می‌شود (از P33-B به بعد
# مهارِ دابل‌تپ رویِ خودِ دیتابیس است، نه رویِ رم). برایِ فعال‌کردن: FSM_STORAGE=postgres
# FSM_STORAGE=memory

# P44 · موردِ ۵۱: پوشهٔ بکاپ. سرویسِ جانبیِ `backup` در docker-compose فایل‌ها را اینجا می‌نویسد
# و ربات هر شب تازه‌ترین را برایِ ادمین می‌فرستد. در اجرایِ محلیِ بدونِ داکر این پوشه لازم نیست.
# BACKUP_DIR=/backups

# --- P45 · ظرفیت (اختیاری؛ پیش‌فرض = رفتارِ تک‌پروسه‌ایِ امروز) ---
# نقشِ این پروسه: all (پیش‌فرض) | core (پنلِ مرکزی + جاب‌ها) | poller (فقط ربات‌هایِ شاردِ خودش)
# | web (فقط دریافتِ webhook). برایِ لایهٔ ۲ و ۳ این‌ها را در deploy/docker-compose.t2.yml و
# deploy/docker-compose.t3.yml گذاشته‌ایم و لازم نیست اینجا بنویسی.
# APP_ROLE=all
# SHARD_COUNT=1
# SHARD_INDEX=0
# در حالتِ webhook، هر پروسه فقط ربات‌هایِ پرمصرف را در حافظه می‌سازد (LRU):
# WEBHOOK_BOT_CACHE_SIZE=400

# --- P20 · امنیت و قابلیتِ مشاهده ---
# سقفِ درخواستِ HTTP به‌ازایِ (IP, مسیر) در هر دقیقه برایِ /webhook/* و صفحهٔ بازگشتِ زرین‌پال.
# ۰ ⇒ محدودسازی خاموش (فقط برایِ تست). پیش‌فرض برایِ تلگرام/بله در اوجِ ترافیک کافی است.
WEBHOOK_RATE_LIMIT_PER_MINUTE=600
# فقط اگر پشتِ nginx/Caddy/Cloudflare هستی: true ⇒ IP از X-Forwarded-For خوانده شود.
# اگر مستقیم در اینترنتی، false بگذار (وگرنه همه از یک IP شمارش می‌شوند و زود به سقف می‌خورند).
TRUST_PROXY_HEADERS=false
# true ⇒ هر خطِ لاگ یک شیءِ JSON (برایِ Loki/CloudWatch). false ⇒ همان متنِ آدم‌خوانا.
# در هر دو حالت رازها (توکنِ ربات، کلید API، موبایلِ مشتری، رمزِ Fernet) از لاگ پاک‌سازی می‌شوند.
JSON_LOGS=false
# رازِ خواندنِ /metrics (شمارنده‌هایِ داخلی: webhook، wallet.deduct، shop.update، …).
# خالی ⇒ endpoint اصلاً وجود ندارد (۴۰۴). با هدرِ X-Metrics-Token بخوانش:
#   curl -H "X-Metrics-Token: <راز>" http://localhost:8000/metrics
METRICS_TOKEN=

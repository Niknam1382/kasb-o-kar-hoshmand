# --- دیتابیس ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kasbokar

# --- ربات اصلی تلگرام (از @BotFather بگیر) ---
MAIN_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- آیدی‌های تلگرامِ ادمین‌های پلتفرم (با کاما جدا کن، بدون فاصله) ---
ADMIN_TELEGRAM_IDS=123456789,987654321

# --- کلید رمزنگاری برای ذخیره‌ی امنِ توکنِ ربات‌های فروشگاهی در دیتابیس ---
# با این دستور یه کلید تازه بساز: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- حالت اجرا: polling (برای تست ساده‌تره، نیازی به دامنه/HTTPS نداره) یا
# webhook (برای پروداکشن، سریع‌تره ولی نیاز به یه آدرسِ HTTPS معتبر داره) ---
RUN_MODE=polling

# --- فقط در حالت webhook لازمه: آدرسِ عمومیِ HTTPS ای که این سرویس روش بالاست ---
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_LISTEN_HOST=0.0.0.0
WEBHOOK_LISTEN_PORT=8000
MAIN_BOT_WEBHOOK_SECRET=
# اختیاری — فقط اگه می‌خواید Bale Pay رو فعال کنید لازمه. جزئیات:
# docs/changelog-phase1a-recovery.md (این یکپارچه‌سازی مستقل تاییدنشده‌ست).
BALE_BOT_TOKEN=
BALE_WEBHOOK_SECRET=

# --- حالت احراز هویتِ ثبت‌نام: test (بدون نیاز به پیامک/ایمیل واقعی، کدِ تایید
# مستقیم توی چت نمایش داده می‌شه — برای تستِ محلی) / sms (با کاوه‌نگار، کلیدش از
# پنل ادمین تنظیم می‌شه، نه از اینجا) / email (با SMTP، تنظیماتش پایین‌تره) ---
AUTH_MODE=test

# --- فقط در حالت AUTH_MODE=email لازمه ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

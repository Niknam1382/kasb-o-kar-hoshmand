# این نسخه مخصوصِ اجرا با docker-compose هست — تفاوتِ اصلیش با .env.example
# اینه که DATABASE_URL به‌جای «localhost»، از نامِ سرویسِ دیتابیس در
# docker-compose.yml («db») استفاده می‌کنه، چون داخلِ شبکه‌ی داکر، کانتینرها با
# اسمِ سرویس همدیگه رو پیدا می‌کنن، نه با localhost.

# --- دیتابیس (این خط رو دست نزن، مگر اینکه docker-compose.yml رو عوض کرده باشی) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/kasbokar

# --- ربات اصلی تلگرام (از @BotFather بگیر) ---
MAIN_BOT_TOKEN=

# --- آیدیِ عددیِ تلگرامِ خودت (از @userinfobot بگیر)، اگه چندتا ادمین داری با کاما جدا کن ---
ADMIN_TELEGRAM_IDS=

# --- کلیدِ رمزنگاری — با دستورِ زیر (بعد از build) بسازش:
# docker compose run --rm bot python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- برای تستِ محلی روی لپ‌تاپ، polling ساده‌ترین حالته (نیازی به دامنه/HTTPS نداره) ---
RUN_MODE=polling
WEBHOOK_BASE_URL=https://example.com
# فقط وقتی RUN_MODE=webhook باشه لازمه — یه رشته‌ی تصادفیِ بلند بساز (مثلاً با
# `openssl rand -hex 32`) تا وب‌هوکِ ربات اصلی امن بشه. اگه خالی بمونه، وب‌هوک
# بدونِ تاییدِ رمز کار می‌کنه (لاگِ هشدار موقعِ startup می‌بینید).
MAIN_BOT_WEBHOOK_SECRET=
# اختیاری — فقط اگه Bale Pay فعاله. جزئیات: docs/changelog-phase1-recovery.md
BALE_BOT_TOKEN=
BALE_WEBHOOK_SECRET=

# --- برای تستِ محلی، test باعث می‌شه کدِ تاییدِ ثبت‌نام مستقیم توی چت نشون داده بشه ---
AUTH_MODE=test

# --- فقط اگه AUTH_MODE=email باشه لازمه؛ برای تستِ محلی خالی بذارشون ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

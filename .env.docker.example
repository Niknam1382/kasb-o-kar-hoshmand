# این نسخه مخصوصِ اجرا با docker-compose هست — تفاوتِ اصلیش با .env.example
# اینه که DATABASE_URL به‌جای «localhost»، از نامِ سرویسِ دیتابیس در
# docker-compose.yml («db») استفاده می‌کنه، چون داخلِ شبکه‌ی داکر، کانتینرها با
# اسمِ سرویس همدیگه رو پیدا می‌کنن، نه با localhost.

# --- دیتابیس (این خط رو دست نزن، مگر اینکه docker-compose.yml رو عوض کرده باشی) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/kasbokar

# --- ربات اصلی تلگرام (از @BotFather بگیر) ---
MAIN_BOT_TOKEN=

# --- آیدیِ عددیِ تلگرامِ خودت (از @userinfobot بگیر)، اگه چندتا ادمین داری با کاما جدا کن ---
ADMIN_TELEGRAM_IDS=

# --- کلیدِ رمزنگاری — با دستورِ زیر (بعد از build) بسازش:
# docker compose run --rm bot python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# P18: توکنِ بله، کلیدهایِ AI (استخر)، کلیدِ پیامکِ کاوه‌نگار و شماره کارتِ پلتفرم با این کلید رمزنگاری می‌شوند.
ENCRYPTION_KEY=

# --- برای تستِ محلی روی لپ‌تاپ، polling ساده‌ترین حالته (نیازی به دامنه/HTTPS نداره) ---
RUN_MODE=polling
WEBHOOK_BASE_URL=https://example.com
# فقط وقتی RUN_MODE=webhook باشه لازمه — یه رشته‌ی تصادفیِ بلند بساز (مثلاً با
# `openssl rand -hex 32`) تا وب‌هوکِ ربات اصلی امن بشه. اگه خالی بمونه، وب‌هوک
# بدونِ تاییدِ رمز کار می‌کنه (لاگِ هشدار موقعِ startup می‌بینید).
MAIN_BOT_WEBHOOK_SECRET=
# اختیاری — فقط اگه Bale Pay فعاله. جزئیات: docs/changelog-phase1-recovery.md
# P18 · A1: هر دو را می‌شود از پنلِ ادمین گذاشت («🔑 تنظیمات کلیدها»)، بدونِ ری‌استارت؛
# اولویت با پنل است و .env پشتیبان.
BALE_BOT_TOKEN=
# در BALE_UPDATES_MODE=polling (پیش‌فرض) لازم نیست؛ در webhook هم خودکار ساخته می‌شود.
# P40: در حالتِ polling endpoint /webhook/bale سرویس نمی‌شود (۴۰۴) تا آپدیتِ جعلی ممکن نباشد.
BALE_WEBHOOK_SECRET=
# آدرسِ پایه‌یِ APIِ بله (فقط اگه بله دامنه را عوض کرد دست بزن)
BALE_API_BASE=https://tapi.bale.ai

# --- P49-الف: کانالِ اینستاگرام (فقط APIِ رسمیِ متا) ---
# این کانال هرگز از APIِ غیررسمی/scraper استفاده نمی‌کند: آن روش رمزِ اکانت را می‌خواهد و خطرِ
# بسته‌شدنِ حسابِ فروشگاه و مشتری دارد. پس فقط سرویسِ رسمیِ متا صدا زده می‌شود.
# سوییچِ سراسری و سه مقدارِ احراز (App ID / App Secret / توکنِ تأیید) از پنلِ ادمین پر می‌شوند.
INSTAGRAM_API_BASE=https://graph.facebook.com
INSTAGRAM_GRAPH_VERSION=v21.0
INSTAGRAM_LOGIN_BASE=https://www.instagram.com/oauth/authorize
# آدرسِ HTTPSِ عمومیِ همین سرویس (پشتِ دامنه‌ای که nginx/Caddy روی آن TLS دارد). در پنلِ متا باید
# همان مقدار را با /webhook/instagram وارد کنی؛ بدونِ آن لینکِ اتصال ساخته نمی‌شود.
INSTAGRAM_PUBLIC_BASE_URL=https://example.com

# --- برای تستِ محلی، test باعث می‌شه کدِ تاییدِ ثبت‌نام مستقیم توی چت نشون داده بشه ---
AUTH_MODE=test

# --- فقط اگه AUTH_MODE=email باشه لازمه؛ برای تستِ محلی خالی بذارشون ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- ظرفیت (اختیاری؛ پیش‌فرض‌ها برایِ شروع کافیه) ---
# اندازه‌یِ استخرِ اتصال‌هایِ دیتابیس. سرِ‌جمعِ workers × DB_POOL_SIZE باید از max_connections
# پستگرس (پیش‌فرض ۱۰۰) کمتر بمونه.
# چرا overflow صفر: بارسنجیِ P20-F رویِ همین کد — در همزمانیِ ۵۰ با overflow=30 فقط
# ۴۸ پیام/ثانیه و میانگینِ ۹۴۶ms؛ با همان استخر و overflow=0 → ۱۳۶ پیام/ثانیه و ۲۴۵ms.
# ساختنِ اتصالِ اضافه در هر موج گران‌تر از صفِ کوتاه است.
# DB_POOL_SIZE=25
# DB_MAX_OVERFLOW=0
# DB_POOL_TIMEOUT=15
# P47: این عدد «سقفِ کلِ پلتفرم» است، نه سقفِ هرِ کلید. سقفِ هرِ کلید در پنلِ ادمین
# (منویِ «🔑 استخرِ کلیدهایِ AI» → «🔢 سقفِ همزمانیِ همینِ کلید») نوشته می‌شود؛ کلیدهایی که
# عددی ننوشته‌اند این مقدار را مساوی بینِ خودشان تقسیم می‌کنند.
# مثالِ ظرفیت: ۱۰ کلید × سقفِ ۲۰۰ ⇒ برایِ ۲٬۰۰۰ درخواستِ هم‌زمان این را ۲۰۰۰ بگذار.
# AI_MAX_CONCURRENT_CALLS=40
# P47: سقفِ صبرِ یکِ درخواست *در صفِ* AI (وقتی همه‌یِ کلیدها پرند) به ثانیه؛ بعد ازِ آن
# به مشتری گفته می‌شود کمی بعد تلاش کند. این زمانِ پاسخ نیست، زمانِ صف است.
# AI_QUEUE_TIMEOUT_SECONDS=120
# P47: سقفِ سوکت‌هایِ هم‌زمان aiohttp به هرِ میزبانِ سرویسِ AI. پیش‌فرضِ خودِ aiohttp ۱۰۰ بود
# و گلوگاهِ خاموشِ مسیرِ AI همین عدد (۰ = بی‌سقف؛ governorِ واقعی AI_MAX_CONCURRENT_CALLS).
# AI_HTTP_POOL_LIMIT=0
# P42 · موردِ ۳۲: سقفِ صبرِ یکِ فراخوانیِ AI به ثانیه. پاسخ‌هایِ بلندِ مودِ مشاوره‌ای با
# ۶۰ ثانیه‌یِ ثابتِ قدیمی تنگضا می‌شدند و مشتری بی‌پاسخ می‌ماند. اگر ارائه‌دهنده‌ات کند است
# بالا ببر (مثلاً ۱۲۰)؛ توجه کن که تایم‌اوت *تکرار نمی‌شود*، پس این عدد سقفِ صبرِ مشتری است.
# AI_TIMEOUT_SECONDS=90
# P29: چند فروشگاه هم‌زمان در راه‌اندازی ثبت/پولینگ شروع کنند. با ۵۰۰ فروشگاه، بی‌این عدد همهٔ
# delete_webhook در یکِ لحظه می‌روند (حالتِ polling) یا ۵۰۰×RTT منتظر می‌مانی (حالتِ webhook).
# کم کردنش برایِ سرورِ کوچک یا IP حساس؛ زیاد کردنش فقط سرعتِ بوت. هیچ رباتی جا نمی‌افتد.
# BOT_REGISTER_CONCURRENCY=24
# P29: سقفِ رمِ سرویسِ ربات در داکر. عددِ اندازه‌گیری‌شده: هر اتصالِ ربات ≈ ۴۱۳ کیلوبایت
# ⇒ ۵۰۰ فروشگاه ≈ ۲۰۲ مگابایت رویِ ~۲۱۷ مگابایتِ پایه + سوکت‌هایِ long-poll. برایِ بیش از
# ~۳۰۰ فروشگاه این را رویِ 2g بگذار (و سرور را هم طبقِ لایهٔ مربوط در playbook بگیر).
# BOT_MEM_LIMIT=2g
# P29: مهلتِ «هنوز بوت می‌شود» برایِ healthcheck. تا پایانِ بارگذاریِ ربات‌ها /health عمداً 503
# می‌دهد؛ با ناوگانِ بزرگ (پاسِ بیوگرافیِ اولین بوت ترتیبی است) این را بالا ببر.
# BOT_HEALTH_START_PERIOD=90s

# P21-B (O2): در حالتِ polling هم یک اپِ سلامتِ کوچک بالا بیاید (فقط /health و /metrics؛
# هیچ مسیرِ webhook در آن نیست). false ⇒ کلاً سروری بالا نمی‌آید.
# HEALTH_ENABLED=true

# P32/P33-B: memory|postgres — با postgres حالتِ چک‌اوت از ری‌استارت رد می‌شود. مسیرِ postgres
# با هر دو نگهدارنده در سوئیت سبز شده؛ مهارِ دابل‌تپ هم دیگر به MemoryStorage وابسته نیست.
# FSM_STORAGE=postgres

# P44 · موردِ ۵۱: بکاپِ خودکار. سرویسِ `backup` (ایمیجِ postgres:16) فایل را در /backups می‌سازد؛
# مسیر را عوض نکن مگر اینکه volume در docker-compose را هم عوض کنی. ساعتِ ساختِ فایل (UTC):
# BACKUP_DIR=/backups
# BACKUP_AT_HOUR_UTC=3
# BACKUP_AT_MINUTE_UTC=5

# W5/B6: polling (پیش‌فرض؛ بدونِ HTTPSِ عمومی) یا webhook
BALE_UPDATES_MODE=polling

# --- P20 · امنیت و قابلیتِ مشاهده (در ظرف) ---
# سقفِ دقیقه‌ایِ هر endpointِ وب‌هوک به‌ازایِ IP (۰ = خاموش).
WEBHOOK_RATE_LIMIT_PER_MINUTE=600
# اگر جلویِ ظرف پراکسی/CDN گذاشتی true کن تا IPِ واقعی از X-Forwarded-For خوانده شود.
TRUST_PROXY_HEADERS=false
# true ⇒ لاگِ JSONِ ساختاریافته (همراه با پاک‌سازیِ رازها در هر دو حالت).
JSON_LOGS=false
# خالی ⇒ /metrics وجود ندارد. پر کن اگر می‌خواهی شمارنده‌ها را به Prometheus بدهی.
METRICS_TOKEN=

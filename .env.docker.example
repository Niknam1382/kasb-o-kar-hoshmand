# این نسخه مخصوصِ اجرا با docker-compose هست — تفاوتِ اصلیش با .env.example
# اینه که DATABASE_URL به‌جای «localhost»، از نامِ سرویسِ دیتابیس در
# docker-compose.yml («db») استفاده می‌کنه، چون داخلِ شبکه‌ی داکر، کانتینرها با
# اسمِ سرویس همدیگه رو پیدا می‌کنن، نه با localhost.

# --- دیتابیس (این خط رو دست نزن، مگر اینکه docker-compose.yml رو عوض کرده باشی) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/kasbokar

# --- ربات اصلی تلگرام (از @BotFather بگیر) ---
MAIN_BOT_TOKEN=

# --- آیدیِ عددیِ تلگرامِ خودت (از @userinfobot بگیر)، اگه چندتا ادمین داری با کاما جدا کن ---
ADMIN_TELEGRAM_IDS=

# --- کلیدِ رمزنگاری — با دستورِ زیر (بعد از build) بسازش:
# docker compose run --rm bot python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# P18: توکنِ بله، کلیدهایِ AI (استخر)، کلیدِ پیامکِ کاوه‌نگار و شماره کارتِ پلتفرم با این کلید رمزنگاری می‌شوند.
ENCRYPTION_KEY=

# --- برای تستِ محلی روی لپ‌تاپ، polling ساده‌ترین حالته (نیازی به دامنه/HTTPS نداره) ---
RUN_MODE=polling
WEBHOOK_BASE_URL=https://example.com
# فقط وقتی RUN_MODE=webhook باشه لازمه — یه رشته‌ی تصادفیِ بلند بساز (مثلاً با
# `openssl rand -hex 32`) تا وب‌هوکِ ربات اصلی امن بشه. اگه خالی بمونه، وب‌هوک
# بدونِ تاییدِ رمز کار می‌کنه (لاگِ هشدار موقعِ startup می‌بینید).
MAIN_BOT_WEBHOOK_SECRET=
# اختیاری — فقط اگه Bale Pay فعاله. جزئیات: docs/changelog-phase1-recovery.md
# P18 · A1: هر دو را می‌شود از پنلِ ادمین گذاشت («🔑 تنظیمات کلیدها»)، بدونِ ری‌استارت؛
# اولویت با پنل است و .env پشتیبان.
BALE_BOT_TOKEN=
# در BALE_UPDATES_MODE=polling (پیش‌فرض) لازم نیست؛ در webhook هم خودکار ساخته می‌شود.
BALE_WEBHOOK_SECRET=
# آدرسِ پایه‌یِ APIِ بله (فقط اگه بله دامنه را عوض کرد دست بزن)
BALE_API_BASE=https://tapi.bale.ai

# --- برای تستِ محلی، test باعث می‌شه کدِ تاییدِ ثبت‌نام مستقیم توی چت نشون داده بشه ---
AUTH_MODE=test

# --- فقط اگه AUTH_MODE=email باشه لازمه؛ برای تستِ محلی خالی بذارشون ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- ظرفیت (اختیاری؛ پیش‌فرض‌ها برایِ شروع کافیه) ---
# اندازه‌یِ استخرِ اتصال‌هایِ دیتابیس. سرِ‌جمعِ workers × DB_POOL_SIZE باید از max_connections
# پستگرس (پیش‌فرض ۱۰۰) کمتر بمونه.
# چرا overflow صفر: بارسنجیِ P20-F رویِ همین کد — در همزمانیِ ۵۰ با overflow=30 فقط
# ۴۸ پیام/ثانیه و میانگینِ ۹۴۶ms؛ با همان استخر و overflow=0 → ۱۳۶ پیام/ثانیه و ۲۴۵ms.
# ساختنِ اتصالِ اضافه در هر موج گران‌تر از صفِ کوتاه است.
# DB_POOL_SIZE=25
# DB_MAX_OVERFLOW=0
# DB_POOL_TIMEOUT=15
# سقفِ فراخوانی‌هایِ هم‌زمانِ AI؛ فراخوانی‌هایِ اضافه صف می‌کشن (نه خطا). با توجه به سقفِ ارائه‌دهنده‌یِ AI تنظیم کن.
# AI_MAX_CONCURRENT_CALLS=40

# P21-B (O2): در حالتِ polling هم یک اپِ سلامتِ کوچک بالا بیاید (فقط /health و /metrics؛
# هیچ مسیرِ webhook در آن نیست). false ⇒ کلاً سروری بالا نمی‌آید.
# HEALTH_ENABLED=true

# W5/B6: polling (پیش‌فرض؛ بدونِ HTTPSِ عمومی) یا webhook
BALE_UPDATES_MODE=polling

# --- P20 · امنیت و قابلیتِ مشاهده (در ظرف) ---
# سقفِ دقیقه‌ایِ هر endpointِ وب‌هوک به‌ازایِ IP (۰ = خاموش).
WEBHOOK_RATE_LIMIT_PER_MINUTE=600
# اگر جلویِ ظرف پراکسی/CDN گذاشتی true کن تا IPِ واقعی از X-Forwarded-For خوانده شود.
TRUST_PROXY_HEADERS=false
# true ⇒ لاگِ JSONِ ساختاریافته (همراه با پاک‌سازیِ رازها در هر دو حالت).
JSON_LOGS=false
# خالی ⇒ /metrics وجود ندارد. پر کن اگر می‌خواهی شمارنده‌ها را به Prometheus بدهی.
METRICS_TOKEN=
